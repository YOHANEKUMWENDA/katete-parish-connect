# Backend Services Configuration
# See BACKEND_SETUP.md for detailed setup instructions

# ============================================
# Stripe (Donations)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
# Test mode keys start with 'test', live with 'live'
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# ============================================
# Sanity CMS (News & Blog)
# ============================================
# Get from your Sanity project settings
VITE_SANITY_PROJECT_ID=your_project_id_here
VITE_SANITY_DATASET=production

# ============================================
# Application URLs
# ============================================
# Development (default)
VITE_BASE_URL=http://localhost:5173

# Production (uncomment and update for production)
# VITE_BASE_URL=https://katetecatholic.org

# ============================================
# Formspree (Contact & Prayer Forms)
# ============================================
# See BACKEND_SETUP.md for form setup
# Form IDs are hardcoded in component files:
# - src/routes/contact.tsx (line ~46)
# - src/routes/prayer.tsx (line ~38)

# ============================================
# Mailchimp (Newsletter)
# ============================================
# Configuration in src/components/MailchimpNewsletter.tsx
# See BACKEND_SETUP.md for list/form ID setup
